# desc: DFlash2 draft instead of the MTP head, 1M context
MODE=hybrid
YARN=1
MTP=0
DRAFT_MODEL=incoai/Qwen3.8-Flash-Next-DFlash2
DRAFT_TOKENS=4
# DFlash2 needs the target's FULL vocabulary (the speculators docs reject pruned draft
# vocabularies), so the MTP-head draft-vocab prune (which defaults to on) is disabled here.
# It only ever applied to the MTP head anyway; set explicitly so the serve line reads truthfully.
DRAFT_VOCAB=0
# 1M-token context with the fp8 KV cache (@Nanetnounou): x1.9 KV, at a speed and some quality cost
CTX=1000000
KV_DTYPE=fp8_e4m3
# The drafter's footprint (0.6B weights + the aux hidden-state ring patch 23 mounts) leaves
# 17.54 GiB for KV at GPU_MEM=0.80, where 1M needs 24.44 GiB — vLLM refuses the boot and puts this
# arm's ceiling at 430,944 tokens. Halving the GDN state pool buys the 6.9 GiB back without
# pushing GPU_MEM past the 0.85 the recipe warns swaps; profiles/mtp4-1m.env sets it too, so the
# A/B stays matched. It also shrinks the mamba page size, which is what vLLM derives the attention
# block size from — watch for the QSA ring complaining here instead if that ever changes.
MAMBA_SSM_DTYPE=bfloat16
