# desc: DFlash2 draft instead of the MTP head, 1M context
MODE=hybrid
YARN=1
MTP=0
DRAFT_MODEL=incoai/Qwen3.8-Flash-Next-DFlash2
DRAFT_TOKENS=4
# DFlash2 needs the target's FULL vocabulary (the speculators docs reject pruned draft
# vocabularies), so the MTP-head draft-vocab prune (which defaults to on) is disabled here.
# It only ever applied to the MTP head anyway; set explicitly so the serve line reads truthfully.
DRAFT_VOCAB=0
# 1M-token context with the fp8 KV cache (@Nanetnounou): x1.9 KV, at a speed and some quality cost
CTX=1000000
KV_DTYPE=fp8_e4m3
# The drafter's footprint is what makes 1M hard here: at GPU_MEM=0.80 vLLM refused the boot with
# "24.44 GiB KV cache is needed, which is larger than the available KV cache memory (17.54 GiB),
# the estimated maximum model length is 430944" — ~10 GiB resident beyond its 1.2 GiB of draft
# weights (the aux hidden-state ring of patch 23 and the V2 runner), measured against the same
# build's MTP arm at 1,133,928 tokens of pool. Halving the GDN state pool was tried first and did
# NOT close a 6.9 GiB gap on its own; what fits is GPU_MEM=0.864, set on profiles/mtp4-1m.env too
# so the two arms differ in the drafter and nothing else. That is above the 0.85 serve.sh warns
# swaps at and the headroom it claims is page-cache for the PLE table, so these tok/s are not
# comparable to the 0.80 tables in the README and this is a benchmark recipe, not a 24/7 one.
# It also shrinks the mamba page size, which is what vLLM derives the attention block size from.
MAMBA_SSM_DTYPE=bfloat16
GPU_MEM=0.864
