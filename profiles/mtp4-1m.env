# desc: the A/B baseline for dflash-1m: the internal MTP head at K=4, 1M context, full draft vocabulary
MODE=hybrid
YARN=1
MTP=4
# Matched to profiles/dflash-1m.env: DFlash2 cannot use the pruned draft vocabulary (it needs the
# target's FULL vocabulary), so the MTP arm must run without it too — otherwise the prune's ~20%
# decode gain lands on the baseline arm and the delta measures nothing.
DRAFT_VOCAB=0
# 1M-token context with the fp8 KV cache (@Nanetnounou): x1.9 KV, at a speed and some quality cost
CTX=1000000
KV_DTYPE=fp8_e4m3
# Neither of the last two lines is needed to fit — this arm boots 1M at GPU_MEM=0.80 with a
# 1,133,928-token pool, with or without the halved state dtype. They are here because an arm pair
# that differs in anything but the drafter moves the delta by more than the drafter: at 0.80 the
# comparison would have been a 1M pool against dflash's 430,944-token ceiling, which is a memory
# story rather than a drafting story. See dflash-1m.env for why 0.864 is the number.
MAMBA_SSM_DTYPE=bfloat16
GPU_MEM=0.864
