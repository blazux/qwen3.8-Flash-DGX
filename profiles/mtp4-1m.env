# desc: the A/B baseline for dflash-1m: the internal MTP head at K=4, 1M context, full draft vocabulary
MODE=hybrid
YARN=1
MTP=4
# Matched to profiles/dflash-1m.env: DFlash2 cannot use the pruned draft vocabulary (it needs
# the target's FULL vocabulary), so the MTP arm must run without it too — otherwise the prune's
# ~20% decode gain lands on the baseline arm and the delta measures nothing.
DRAFT_VOCAB=0
# 1M-token context with the fp8 KV cache (@Nanetnounou): x1.9 KV, at a speed and some quality cost
CTX=1000000
KV_DTYPE=fp8_e4m3
# Not needed to fit — the MTP arm boots at 1M without it. Set to match dflash-1m, which does need
# the halved GDN state pool: the two arms have to differ in the drafter and nothing else, so a
# state dtype that one arm runs and the other doesn't would move the delta by more than the draft.
MAMBA_SSM_DTYPE=bfloat16
