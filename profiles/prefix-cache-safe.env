# desc: Native 256K, MTP3, prefix reuse through boundary-split prefills
# See docs/PREFIX-CACHE-WORKAROUND.md; other profiles remain unchanged.
IMAGE=qwen38-flash-dgx:v0.33-prefix-safe
MODE=hybrid
PORT=127.0.0.1:18300
YARN=0
CTX=262144
SEQS=16
MAMBA_SSM_DTYPE=bfloat16
KV_DTYPE=fp8_e4m3
KV_CACHE_MEM=13958643712
GPU_MEM=0.80
MTP=3
DRAFT_VOCAB=0
MTP_DRAFT_QUANT=nvfp4
BATCH_TOKENS=16384
PREFIX_CACHE=1
SPLIT_PREFILL=1
DET_TOPK=1
EFFORT_ALIAS=1
COMPILE_CACHE=qwen38-compile
