+"""Schema-authoritative, single-layer repair of an accidental arguments wrapper."""
+from __future__ import annotations
+
+import json
+from jsonschema.exceptions import SchemaError, ValidationError
+from jsonschema.validators import validator_for
+from referencing import Registry
+from referencing.exceptions import Unresolvable
+
+
+class InvalidToolArguments(ValueError):
+    """No executable tool call may be emitted; exception never carries payloads."""
+
+
+def _pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("Duplicate JSON object key")
+        result[key] = value
+    return result
+
+
+def _constant(value):
+    raise ValueError("Non-JSON numeric constant")
+
+
+def _loads(value):
+    return json.loads(value, object_pairs_hook=_pairs, parse_constant=_constant)
+
+
+def find_parameters(tools, canonical_name):
+    """Use only the exact already-resolved offered function/namespace name."""
+    matches = []
+    for tool in tools or []:
+        item = tool.model_dump() if hasattr(tool, "model_dump") else tool
+        if not isinstance(item, dict):
+            continue
+        if item.get("type") == "namespace":
+            namespace = item.get("name")
+            for child in item.get("tools", []):
+                if (child.get("type") == "function" and namespace
+                        and namespace + "__" + child.get("name", "") == canonical_name):
+                    matches.append(child.get("parameters"))
+        elif item.get("type") == "function":
+            function = item.get("function", item)
+            if function.get("name") == canonical_name:
+                matches.append(function.get("parameters"))
+    # Duplicate names cannot authorize a schema-based transformation.
+    if len(matches) != 1:
+        return None
+    return matches[0]
+
+
+def validate_or_unwrap(arguments_json, schema):
+    """Preserve valid input exactly; otherwise unwrap once only on full proof.
+
+    An absent schema preserves legacy input, with no inferred requirements or
+    wrapper repair. Unknown/unresolvable supplied schemas fail visibly. No
+    network $ref retrieval, recursive unwrap, coercion or parameter guessing.
+    """
+    if schema is None:
+        return arguments_json
+    try:
+        if isinstance(schema, dict) and "$schema" in schema:
+            validator_cls = validator_for(schema, default=None)
+            if validator_cls is None:
+                raise InvalidToolArguments("Unsupported tool argument schema dialect")
+        else:
+            validator_cls = validator_for(schema)
+        validator_cls.check_schema(schema)
+        # Registry() refuses remote retrieval; local definitions still work.
+        validator = validator_cls(schema, registry=Registry())
+        original = _loads(arguments_json)
+        try:
+            validator.validate(original)
+            return arguments_json
+        except ValidationError:
+            pass
+        if not isinstance(original, dict) or set(original) != {"arguments"}:
+            raise InvalidToolArguments("Tool arguments violate offered schema")
+        inner = original["arguments"]
+        if isinstance(inner, str):
+            inner = _loads(inner)
+        if not isinstance(inner, dict):
+            raise InvalidToolArguments("Tool arguments violate offered schema")
+        validator.validate(inner)
+        return json.dumps(inner, ensure_ascii=False, allow_nan=False)
+    except InvalidToolArguments:
+        raise
+    except (SchemaError, ValidationError, Unresolvable, ValueError, TypeError,
+            KeyError, RecursionError):
+        raise InvalidToolArguments("Tool arguments cannot be validated against offered schema") from None
