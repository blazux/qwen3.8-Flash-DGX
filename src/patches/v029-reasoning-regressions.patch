+class _EOSGuardConfig(_MockReasoningConfig):
+    suppress_eos_in_reasoning = True
+    reasoning_start_token_ids = [10]
+    reasoning_end_token_ids = [11]
+    natural_reasoning_end_token_ids = [11]
+    _eos_token_ids = [1, 2]
+    _tool_start_token_id = 12
